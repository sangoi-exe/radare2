NAME=struct callback can return a function pointer
FILE=--
ARGS=-b 64
CMDS=<<EOF
'td struct rea_callbacks { void (*(*xDlSym)(void *ctx, void *handle, const char *name))(void); int (*next)(int n); };
tk tags/struct.rea_callbacks
tk tags/struct.rea_callbacks.xDlSym
tk tags/struct.rea_callbacks.next
tk~^func.rea_callbacks
EOF
EXPECT=<<EOF
xDlSym,next
void (*(*)(void *ctx, void *handle, const char *name))(void),0,0
int (*)(int n),8,0
EOF
RUN

NAME=same import callback array parameter uses pointer layout
FILE=--
ARGS=-b 64
CMDS=<<EOF
'td typedef int (*CB)(int x[4]); struct S { CB callback; char tail; };
tk typedef.CB
tk tags/struct.S.callback
tk tags/struct.S.tail
tk tags/type.S.size
EOF
EXPECT=<<EOF
func.CB *
CB,0,0
char,8,0
128
EOF
RUN

NAME=same import transitive callback alias and outer pointer arrays
FILE=--
ARGS=-b 64
CMDS=<<EOF
'td typedef int (*CB)(int x[4]); typedef CB CB2; struct S { CB2 callback; char tail; }; typedef int *Pointers[2]; struct PointerArrays {int *direct[2]; Pointers indirect; char tail;};
tk typedef.CB2
tk tags/struct.S.callback
tk tags/struct.S.tail
tk tags/type.S.size
tk tags/struct.PointerArrays.indirect
tk tags/struct.PointerArrays.tail
tk tags/type.PointerArrays.size
EOF
EXPECT=<<EOF
CB
CB2,0,0
char,8,0
128
Pointers,16,0
char,32,0
320
EOF
RUN

NAME=union callback members overlap and pointer spacing is optional
FILE=--
ARGS=-b 64
CMDS=<<EOF
'td union rea_callback_union { void*(*first)(int n); int (*second)(void); int value; };
tk tags/union.rea_callback_union
tk tags/union.rea_callback_union.first
tk tags/union.rea_callback_union.second
tk tags/union.rea_callback_union.value
tk func.rea_callback_union.first.ret
tk func.rea_callback_union.first.arg.0
EOF
EXPECT=<<EOF
first,second,value
void *(*)(int n),0,0
int (*)(void),0,0
int,0,0
EOF
RUN

NAME=Win16 far callback retains explicit object layers and readable declarations
FILE=--
ARGS=-a x86 -b 16
CMDS=<<EOF
'td typedef int (far *CB)(int n);struct F {char lead;CB cb;char tail;};
tk typedef.CB
tss func.CB
tss CB
tk tags/struct.F.cb
tk tags/struct.F.tail
tss struct F
ttc CB
tsc struct F
ts struct F
EOF
EXPECT=<<EOF
func.CB far *
0
4
CB,2,0
char,6,0
8
typedef int (far *CB)(int n);
struct F {
  char lead;
  CB cb;
  char tail;
};
'pf c[1].p4c lead cb tail
EOF
RUN

NAME=Win16 mixed pointer declarations preserve their individual layers
FILE=--
ARGS=-a x86 -b 16
CMDS=<<EOF
'td typedef unsigned char BYTE;struct Layers {BYTE far * volatile near *p;BYTE far **q;};
tk tags/struct.Layers.p
tk tags/struct.Layers.q
tss struct Layers
tsc struct Layers
EOF
EXPECT=<<EOF
BYTE far * volatile near *,0,0
BYTE far * *,2,0
4
struct Layers {
  BYTE far * volatile near *p;
  BYTE far * *q;
};
EOF
RUN
