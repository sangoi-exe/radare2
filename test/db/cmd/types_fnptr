NAME=struct callback can return a function pointer
FILE=--
ARGS=-b 64
CMDS=<<EOF
'td struct rea_callbacks { void (*(*xDlSym)(void *ctx, void *handle, const char *name))(void); int (*next)(int n); };
tk struct.rea_callbacks
tk struct.rea_callbacks.xDlSym
tk struct.rea_callbacks.next
tk~^func.rea_callbacks
EOF
EXPECT=<<EOF
xDlSym,next
func.rea_callbacks.xDlSym *,0,0
func.rea_callbacks.next *,8,0
func.rea_callbacks.next=n
func.rea_callbacks.next.arg.0=int,n
func.rea_callbacks.next.args=1
func.rea_callbacks.next.cc=cdecl
func.rea_callbacks.next.ret=int
func.rea_callbacks.xDlSym=ctx,handle,name
func.rea_callbacks.xDlSym.arg.0=void *,ctx
func.rea_callbacks.xDlSym.arg.1=void *,handle
func.rea_callbacks.xDlSym.arg.2=const char *,name
func.rea_callbacks.xDlSym.args=3
func.rea_callbacks.xDlSym.cc=cdecl
func.rea_callbacks.xDlSym.ret=void (*)(void)
EOF
RUN

NAME=same import callback array parameter uses pointer layout
FILE=--
ARGS=-b 64
CMDS=<<EOF
'td typedef int (*CB)(int x[4]); struct S { CB callback; char tail; };
tk typedef.CB
tk struct.S.callback
tk struct.S.tail
tk type.S.size
EOF
EXPECT=<<EOF
func.CB *
CB,0,0
char,8,0
128
EOF
RUN

NAME=same import transitive callback alias and outer pointer arrays
FILE=--
ARGS=-b 64
CMDS=<<EOF
'td typedef int (*CB)(int x[4]); typedef CB CB2; struct S { CB2 callback; char tail; }; typedef int *Pointers[2]; struct PointerArrays {int *direct[2]; Pointers indirect; char tail;};
tk typedef.CB2
tk struct.S.callback
tk struct.S.tail
tk type.S.size
tk struct.PointerArrays.indirect
tk struct.PointerArrays.tail
tk type.PointerArrays.size
EOF
EXPECT=<<EOF
CB
CB2,0,0
char,8,0
128
Pointers,16,0
char,32,0
320
EOF
RUN

NAME=union callback members overlap and pointer spacing is optional
FILE=--
ARGS=-b 64
CMDS=<<EOF
'td union rea_callback_union { void*(*first)(int n); int (*second)(void); int value; };
tk union.rea_callback_union
tk union.rea_callback_union.first
tk union.rea_callback_union.second
tk union.rea_callback_union.value
tk func.rea_callback_union.first.ret
tk func.rea_callback_union.first.arg.0
EOF
EXPECT=<<EOF
first,second,value
func.rea_callback_union.first *,0,0
func.rea_callback_union.second *,0,0
int,0,0
void *
int,n
